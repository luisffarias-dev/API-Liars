generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  nickname String @unique
  role     Role   @default(PLAYER)

  // CORRIGIDO AQUI 👇 (String? e aspas no valor)
  avatar String? @default("default.png")

  wins          Int @default(0)
  matchesPlayed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches MatchPlayer[]
}

// Definições de estados para controle de fluxo
enum MatchStatus {
  WAITING // Aguardando fechar os 4 players
  PLAYING // Partida em andamento (fase de blefe)
  PENALTY // Alguém está no duelo de Jokenpo contra o PC
  FINISHED // Partida encerrada
}

enum PlayerStatus {
  SAFE // Jogador ativo no jogo
  IN_PENALTY // Jogador no duelo contra o PC (RNG)
  ELIMINATED // Perdeu o duelo e saiu da partida
}

model Match {
  id        String      @id @default(uuid())
  status    MatchStatus @default(WAITING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relação com os jogadores da mesa
  players MatchPlayer[]
}

model MatchPlayer {
  id     String       @id @default(uuid())
  status PlayerStatus @default(SAFE)
  cards  String[]     @default([])

  // Relação com Match
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  // Relação com User
  user   User   @relation(fields: [userId], references: [id])
  userId String
}
